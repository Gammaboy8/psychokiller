# Supabase — get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL (used for share links, OG tags, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social / community links (shown in header + footer)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your-handle
NEXT_PUBLIC_TWITTER_URL=https://x.com/your-handle

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
